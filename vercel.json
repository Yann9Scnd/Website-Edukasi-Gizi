{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "vite build",
  "env": {
    "APP_NAME": "laravel",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://nadibunda.vercel.app",
    "APP_KEY": "base64:QAJqUIr7w4/8a4olA0uUtziTu40uHN+DBgpaC45Si9Q=",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "DB_CONNECTION": "mysql",
    "VIEW_COMPILED_PATH": "/tmp",
    "LOG_CHANNEL": "stderr"
  },
  "outputDirectory": "public"
}